# ── Dify 工作流 API ───────────────────────────────────────────
# 复制本文件为 backend/.env 后填写。.env 已被 .gitignore 忽略，不会被提交。
DIFY_BASE_URL=https://api.dify.ai/v1
# 在 Dify 应用「访问 API」页面生成的工作流 API 密钥（以 app- 开头）
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选 ─────────────────────────────────────────────────────
# 工作流 End 节点的输出变量名（与当前 v3 工作流一致，一般无需修改）
# DIFY_OUTPUT_JD_KEY=final_jd
# DIFY_OUTPUT_MISSING_KEY=missing_info

# 单次生成的最长等待时间（秒）
# GENERATION_TIMEOUT=300

# Mock 模式：不调用 Dify，回放一段录制好的真实输出，用于调样式/演示，不消耗额度
# DIFY_MOCK=false
